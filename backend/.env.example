# Copy this file to .env and fill in real values.
# Never commit .env or firebase-service-account.json — both are in .gitignore.

# --- App ---
ENV=development
# Comma-separated list of origins allowed to call this API (your Vite dev server, prod domain, etc.)
ALLOWED_ORIGINS=http://localhost:5173

# --- Firebase (Auth) ---
# Firebase Console > Project settings > Service accounts > Generate new private key.
# Save the downloaded JSON as backend/firebase-service-account.json (default path below),
# or paste its contents into FIREBASE_SERVICE_ACCOUNT_JSON_INLINE as a one-line JSON string instead.
FIREBASE_SERVICE_ACCOUNT_JSON=./firebase-service-account.json

# --- Cloudinary (Files) ---
# Cloudinary Console > Dashboard, top of the page.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_UPLOAD_FOLDER=caresync

# --- Grok / xAI (AI brief + chatbot) ---
GROK_API_KEY=
# Grok's API is OpenAI-compatible; this is the base URL for it, not something to change per-key.
GROK_BASE_URL=https://api.x.ai/v1
GROK_MODEL=grok-4

# --- Hindsight (chatbot memory) ---
# Self-hosted: run `docker run -p 8888:8888 -p 9999:9999 -e HINDSIGHT_API_LLM_API_KEY=... ghcr.io/vectorize-io/hindsight:latest`
# then leave HINDSIGHT_BASE_URL as the default below and HINDSIGHT_API_KEY blank.
# Hindsight Cloud: set HINDSIGHT_BASE_URL=https://api.hindsight.vectorize.io and set HINDSIGHT_API_KEY.
HINDSIGHT_BASE_URL=http://localhost:8888
HINDSIGHT_API_KEY=
