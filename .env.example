# Copy to .env and fill in real values.
# Vite only exposes variables prefixed VITE_ to the browser, so nothing
# secret should ever go here — this is public web app config, not an API key
# with write access.

# Where the FastAPI backend is running (see backend/README.md).
# Local dev: point at uvicorn directly, including the /api prefix.
# Deployed on Vercel: leave this UNSET — the frontend and the backend's
# serverless function share one domain there, so the code falls back to
# the relative path "/api" automatically.
VITE_API_BASE_URL=http://localhost:8000/api

# Firebase Console > Project settings > General > Your apps > Web app > Config.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=
